# @defaultSensitive=true
# ---

# @type=enum(local, staging, production) @sensitive=false
APP_ENV=local

# @type=url @required=false @sensitive=false
SUPABASE_URL=

# Public key, protected by RLS rather than secrecy.
# @required=false @sensitive=false
SUPABASE_PUBLISHABLE_KEY=

# Optional: Sentry auth token for CI source map / R8 mapping upload (never in client bundles).
# @required=false
SENTRY_AUTH_TOKEN=

# Optional: Sentry org/project for EAS upload (used by @sentry/react-native/expo plugin).
# @required=false @sensitive=false
SENTRY_ORG=

# @required=false @sensitive=false
SENTRY_PROJECT=

# Optional: Resend (server/CI only).
# @required=false
RESEND_API_KEY=

# @required=false @sensitive=false
RESEND_FROM=

# Optional: AI translation of Lingui .po catalogs (`pnpm i18n:translate`).
# Set exactly one provider key. Never put these in VITE_* / EXPO_PUBLIC_*.
# @required=false
OPENAI_API_KEY=

# @required=false
ANTHROPIC_API_KEY=

# @required=false
GEMINI_API_KEY=
