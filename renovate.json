{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "dependencyDashboard": true,
  "automerge": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "expo",
        "expo-*",
        "react-native",
        "react-native-*",
        "@react-native/**",
        "react",
        "react-dom",
        "react-test-renderer"
      ],
      "groupName": "Expo compatibility set"
    },
    { "matchPackageNames": ["@lingui/**"], "groupName": "Lingui" }
  ]
}
