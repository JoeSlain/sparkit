{
  "expo": {
    "name": "Workspace",
    "slug": "agency-starter",
    "scheme": "agencystarter",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.agencystarter.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.agencystarter.app"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
