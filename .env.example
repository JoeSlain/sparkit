# Run pnpm db:start to generate local frontend environment files.
# Never put database credentials or a service-role key in VITE_* / EXPO_PUBLIC_*.
APP_ENV=local
SUPABASE_URL=http://127.0.0.1:54381
SUPABASE_PUBLISHABLE_KEY=

# Optional CI / server secrets (never ship in client bundles).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# RESEND_API_KEY=
# RESEND_FROM=

# Optional: fill one key to run `pnpm i18n:translate` (OpenAI by default).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
