    "@sparkit/i18n": "workspace:*",
    "@sparkit/integrations": "workspace:*",
    "@sparkit/supabase": "workspace:*",
    "@sparkit/tokens": "workspace:*",
    "@sparkit/validation": "workspace:*",
    "@supabase/supabase-js": "2.116.0",
    "@tamagui/core": "2.7.7",
    "@tamagui/stacks": "2.7.7",
    "@tanstack/react-query": "5.102.8",
    "expo": "57.0.22",
    "expo-build-properties": "57.0.17",
    "expo-constants": "57.0.18",
    "expo-dev-client": "57.0.19",
    "expo-linking": "57.0.10",
