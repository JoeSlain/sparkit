{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": { "simulator": true },
      "env": {
        "EAS_USE_CACHE": "1",
        "EAS_GRADLE_CACHE": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EAS_USE_CACHE": "1",
        "EAS_GRADLE_CACHE": "1"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EAS_USE_CACHE": "1",
        "EAS_GRADLE_CACHE": "1"
      }
    }
  }
}
