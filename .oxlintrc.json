{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import"],
  "categories": { "correctness": "error" },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/ios/**",
    "**/android/**",
    "**/locales/**",
    "**/.react-router/**",
    "**/.expo/**"
  ]
}
