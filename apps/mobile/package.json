{
  "name": "@sparkit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client --max-workers 2",
    "ios": "stim ios",
    "android": "stim android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build": "pnpm build:ios && pnpm build:android",
    "lint": "oxlint .",
    "build:ios": "expo export --platform ios --output-dir dist/ios --max-workers 2",
    "build:android": "expo export --platform android --output-dir dist/android --max-workers 2"
  },
