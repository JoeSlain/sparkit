# iOS simulator: host loopback. Android emulator: use http://10.0.2.2:54381.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54381
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
